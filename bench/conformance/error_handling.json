{
  "suite": "error_handling",
  "cases": [
    {
      "name": "validated-mismatched-close",
      "profile": "validated",
      "xml": "<a><b></a>",
      "expect_ok": false,
      "expect_error": "InvalidClosingTagName"
    },
    {
      "name": "validated-unterminated-quote",
      "profile": "validated",
      "xml": "<a x='1></a>",
      "expect_ok": false,
      "expect_error": "ExpectedQuote"
    },
    {
      "name": "validated-invalid-numeric-entity",
      "profile": "validated_entities",
      "xml": "<a>&#x110000;</a>",
      "expect_ok": false,
      "expect_error": "InvalidNumericCharacterEntity"
    },
    {
      "name": "validated-unexpected-end",
      "profile": "validated",
      "xml": "<a><b></b>",
      "expect_ok": false,
      "expect_error": "UnexpectedEndOfData"
    },
    {
      "name": "permissive-allows-mismatched-close",
      "profile": "permissive",
      "xml": "<a><b></a>",
      "expect_ok": true,
      "expect_elements": 2,
      "expect_root_name": "a"
    }
  ]
}
