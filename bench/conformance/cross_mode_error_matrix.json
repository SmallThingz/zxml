{
  "suite": "cross_mode_error_matrix",
  "cases": [
    {
      "name": "unexpected-end-open-tag-both-fail",
      "profiles": [
        "validated",
        "permissive"
      ],
      "xml": "<a><b",
      "expect_ok": false,
      "expect_error": "UnexpectedEndOfData"
    },
    {
      "name": "validated-mismatched-close-fails",
      "profile": "validated",
      "xml": "<a><b></a>",
      "expect_ok": false,
      "expect_error": "InvalidClosingTagName"
    },
    {
      "name": "permissive-mismatched-close-pass",
      "profile": "permissive",
      "xml": "<a><b></a>",
      "expect_ok": true,
      "expect_elements": 2,
      "expect_root_name": "a"
    },
    {
      "name": "validated-invalid-close-name-fails",
      "profile": "validated",
      "xml": "<a></1>",
      "expect_ok": false,
      "expect_error": "InvalidClosingTagName"
    },
    {
      "name": "permissive-invalid-close-name-pass",
      "profile": "permissive",
      "xml": "<a></1>",
      "expect_ok": true,
      "expect_elements": 1,
      "expect_root_name": "a"
    },
    {
      "name": "validated-unterminated-quote-fails",
      "profile": "validated",
      "xml": "<a x='1></a>",
      "expect_ok": false,
      "expect_error": "ExpectedQuote"
    },
    {
      "name": "permissive-unterminated-quote-errors-safely",
      "profile": "permissive",
      "xml": "<a x='1></a>",
      "expect_ok": false,
      "expect_error": "UnexpectedEndOfData"
    },
    {
      "name": "validated-unterminated-pi-fails",
      "profile": "validated",
      "xml": "<?p x <r/>",
      "expect_ok": false,
      "expect_error": "UnexpectedEndOfData"
    },
    {
      "name": "permissive-unterminated-pi-pass",
      "profile": "permissive",
      "xml": "<?p x <r/>",
      "expect_ok": true,
      "expect_elements": 0
    },
    {
      "name": "validated-unterminated-comment-fails",
      "profile": "validated",
      "xml": "<r><!--x</r>",
      "expect_ok": false,
      "expect_error": "UnexpectedEndOfData"
    },
    {
      "name": "permissive-unterminated-comment-pass",
      "profile": "permissive",
      "xml": "<r><!--x</r>",
      "expect_ok": true,
      "expect_elements": 1,
      "expect_root_name": "r"
    },
    {
      "name": "validated-unterminated-cdata-fails",
      "profile": "validated",
      "xml": "<r><![CDATA[x</r>",
      "expect_ok": false,
      "expect_error": "UnexpectedEndOfData"
    },
    {
      "name": "permissive-unterminated-cdata-pass",
      "profile": "permissive",
      "xml": "<r><![CDATA[x</r>",
      "expect_ok": true,
      "expect_elements": 1,
      "expect_root_name": "r"
    },
    {
      "name": "validated-unterminated-doctype-fails",
      "profile": "validated",
      "xml": "<!DOCTYPE r [<!ELEMENT r ANY><r/>",
      "expect_ok": false,
      "expect_error": "UnexpectedEndOfData"
    },
    {
      "name": "permissive-unterminated-doctype-pass",
      "profile": "permissive",
      "xml": "<!DOCTYPE r [<!ELEMENT r ANY><r/>",
      "expect_ok": true,
      "expect_elements": 0
    },
    {
      "name": "validated-unquoted-attr-fails",
      "profile": "validated",
      "xml": "<r a=1></r>",
      "expect_ok": false,
      "expect_error": "ExpectedQuote"
    },
    {
      "name": "permissive-unquoted-attr-pass",
      "profile": "permissive",
      "xml": "<r a=1></r>",
      "expect_ok": true,
      "expect_elements": 1,
      "expect_root_name": "r",
      "expect_root_attr_name": "a",
      "expect_root_attr_value": "1"
    },
    {
      "name": "validated-missing-attribute-equals-fails",
      "profile": "validated",
      "xml": "<r a/>",
      "expect_ok": false,
      "expect_error": "ExpectedEq"
    },
    {
      "name": "validated-adjacent-attributes-without-space-fail",
      "profile": "validated",
      "xml": "<r a='1'b='2'/>",
      "expect_ok": false,
      "expect_error": "ExpectedAttributeName"
    },
    {
      "name": "validated-whitespace-around-equals-passes",
      "profile": "validated",
      "xml": "<r a = '1'/>",
      "expect_ok": true,
      "expect_elements": 1,
      "expect_root_name": "r",
      "expect_root_attr_name": "a",
      "expect_root_attr_value": "1"
    },
    {
      "name": "validated-space-after-end-tag-open-fails",
      "profile": "validated",
      "xml": "<r></ r>",
      "expect_ok": false,
      "expect_error": "InvalidClosingTagName"
    },
    {
      "name": "validated-invalid-surrogate-entity-fails",
      "profile": "validated_entities",
      "xml": "<r>&#xD800;</r>",
      "expect_ok": false,
      "expect_error": "InvalidNumericCharacterEntity"
    },
    {
      "name": "permissive-invalid-surrogate-entity-literal",
      "profile": "permissive_entities",
      "xml": "<r>&#xD800;</r>",
      "expect_ok": true,
      "expect_elements": 1,
      "expect_root_name": "r",
      "expect_first_text": "&#xD800;"
    }
  ]
}
